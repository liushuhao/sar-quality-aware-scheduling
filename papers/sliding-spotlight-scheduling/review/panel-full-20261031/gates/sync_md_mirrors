unmatched = []
for name in targets:
    p = base / name
    if not p.exists():
        print(f"MISSING FILE {name}")
        continue
    t = p.read_text(encoding="utf-8")
    applied = 0
    for old, new in PAIRS:
        n = t.count(old)
        if n == 0:
            continue
        t = t.replace(old, new)
        applied += n
    if applied:
        p.write_text(t, encoding="utf-8")
    print(f"{name}: applied {applied} replacement(s)")

print("\nper-pair coverage across all files:")
for i, (old, _) in enumerate(PAIRS, 1):
    total = sum((base / n).read_text(encoding="utf-8").count(old) for n in targets if (base / n).exists())
    if total:
        unmatched.append((i, total))
